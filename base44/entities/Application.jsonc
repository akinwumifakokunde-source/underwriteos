{
  "name": "Application",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "environment": {
      "type": "string",
      "enum": [
        "sandbox",
        "production"
      ],
      "default": "sandbox",
      "description": "Isolation environment. Sandbox records never mix with production."
    },
    "application_number": {
      "type": "string"
    },
    "borrower_id": {
      "type": "string"
    },
    "market": {
      "type": "string",
      "enum": [
        "GB",
        "US",
        "NG",
        "ZA",
        "KE",
        "GH"
      ],
      "default": "GB",
      "description": "Country / market for this application. Determines currency, regulatory profile, and available policies."
    },
    "regulatory_profile": {
      "type": "string",
      "description": "Regulatory profile label (e.g. UK Consumer Credit, US Consumer Lending)."
    },
    "state": {
      "type": "string",
      "description": "US state or region, where applicable."
    },
    "borrower_type": {
      "type": "string",
      "enum": [
        "salaried",
        "self_employed",
        "business"
      ],
      "default": "salaried",
      "description": "Borrower type. Affects document requirements and assessment approach."
    },
    "product_type": {
      "type": "string",
      "default": "personal_loan",
      "description": "Loan product type (e.g. personal_loan, auto_loan, business_loan)"
    },
    "loan_amount": {
      "type": "number"
    },
    "loan_currency": {
      "type": "string",
      "default": "GBP"
    },
    "loan_purpose": {
      "type": "string"
    },
    "loan_term_months": {
      "type": "number"
    },
    "interest_rate": {
      "type": "number"
    },
    "policy_id": {
      "type": "string",
      "default": "consumer-v1"
    },
    "policy_version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "data_collection",
        "analyzing",
        "underwriting",
        "completed",
        "failed"
      ],
      "default": "draft"
    },
    "decision": {
      "type": "string",
      "enum": [
        "APPROVE",
        "REVIEW",
        "DECLINE",
        "null"
      ],
      "default": "null"
    },
    "risk_score": {
      "type": "number"
    },
    "probability_of_default": {
      "type": "number"
    },
    "confidence": {
      "type": "number"
    },
    "human_review_required": {
      "type": "boolean",
      "default": false
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "idempotency_key": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "borrower_id",
    "loan_amount"
  ]
}