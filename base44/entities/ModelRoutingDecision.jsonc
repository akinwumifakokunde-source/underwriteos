{
  "name": "ModelRoutingDecision",
  "type": "object",
  "description": "Audit record of the automatic credit risk model routing. Records the market/product/borrower context, the eligible validated models, their ranking, the selected model, the fallback chain, and per-model feature completeness. There is no model-selection UI; this record explains why a given model was chosen.",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "application_id": {
      "type": "string"
    },
    "environment": {
      "type": "string",
      "enum": [
        "sandbox",
        "production"
      ],
      "default": "sandbox"
    },
    "market": {
      "type": "string"
    },
    "product_type": {
      "type": "string"
    },
    "borrower_type": {
      "type": "string"
    },
    "eligible_models": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Names of validated+production models compatible with this application's context and feature set."
    },
    "ranked_models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "model_name": {
            "type": "string"
          },
          "rank": {
            "type": "number"
          },
          "score": {
            "type": "number"
          },
          "role": {
            "type": "string",
            "enum": [
              "champion",
              "challenger",
              "benchmark"
            ]
          }
        }
      }
    },
    "selected_model": {
      "type": "string",
      "description": "Highest-ranked eligible validated model. Null/empty when no eligible model is available."
    },
    "selection_reason": {
      "type": "string"
    },
    "fallback_chain": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ordered list of models to try if the selected model cannot run."
    },
    "feature_completeness": {
      "type": "object",
      "description": "Per-model map of missing required features, used to determine eligibility."
    },
    "is_mock": {
      "type": "boolean",
      "default": false
    },
    "routing_timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organization_id",
    "application_id"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}