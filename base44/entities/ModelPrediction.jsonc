{
  "name": "ModelPrediction",
  "type": "object",
  "description": "Reproducible record of a single credit risk model prediction. Produced by the ASSESS layer's CreditRiskModelProvider after automatic model routing. Stores PD, CreditDecide Risk Score, risk band, feature contributions, the full input feature snapshot, and model/version metadata so any past underwriting decision can be reproduced and audited. Separate from the bureau-provided credit score.",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "application_id": {
      "type": "string"
    },
    "environment": {
      "type": "string",
      "enum": [
        "sandbox",
        "production"
      ],
      "default": "sandbox"
    },
    "model_name": {
      "type": "string",
      "description": "e.g. ebm-v1, xgboost-v1, logistic-woe-v1"
    },
    "model_type": {
      "type": "string",
      "enum": [
        "ebm",
        "xgboost",
        "lightgbm",
        "catboost",
        "logistic_woe",
        "external"
      ]
    },
    "model_version": {
      "type": "string"
    },
    "feature_set_version": {
      "type": "string"
    },
    "routing_decision_id": {
      "type": "string",
      "description": "The ModelRoutingDecision that selected this model"
    },
    "probability_of_default": {
      "type": "number",
      "description": "PD in 0..1, produced by the model provider"
    },
    "credit_risk_score": {
      "type": "number",
      "description": "CreditDecide Risk Score in 0..1 (higher = riskier). Generated by the model, NOT the bureau score."
    },
    "risk_band": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E"
      ],
      "description": "A=very low risk .. E=very high risk"
    },
    "bureau_score": {
      "type": "number",
      "description": "Bureau-provided credit score, stored separately from the CreditDecide risk score."
    },
    "bureau_score_source": {
      "type": "string",
      "description": "Bureau provider that produced the bureau score"
    },
    "feature_contributions": {
      "type": "array",
      "description": "Per-feature contribution to the model output, for explainability.",
      "items": {
        "type": "object",
        "properties": {
          "feature": {
            "type": "string"
          },
          "value": {},
          "contribution": {
            "type": "number"
          },
          "direction": {
            "type": "string",
            "enum": [
              "positive",
              "negative"
            ]
          }
        }
      }
    },
    "input_feature_snapshot": {
      "type": "object",
      "description": "Full deterministic feature vector used for the prediction, with per-feature provenance (sources, formula, calc version, timestamp)."
    },
    "model_quality_metadata": {
      "type": "object",
      "description": "Governance metadata: AUC, Gini, Brier, calibration, validation status, champion/challenger/benchmark status."
    },
    "is_mock": {
      "type": "boolean",
      "default": false,
      "description": "True when produced by a DEMO/MOCK provider. Never mixed with production decisions."
    },
    "prediction_timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organization_id",
    "application_id",
    "model_name",
    "probability_of_default"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}