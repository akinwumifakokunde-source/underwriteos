{
  "name": "CreditProfile",
  "type": "object",
  "description": "Normalized credit profile. All fields are nullable because different providers may not supply every field.",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "application_id": {
      "type": "string"
    },
    "credit_report_id": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "description": "Bureau provider that produced the source report"
    },
    "credit_score": {
      "type": "number",
      "description": "Nullable"
    },
    "score_band": {
      "type": "string",
      "description": "Nullable"
    },
    "active_accounts": {
      "type": "number",
      "description": "Nullable"
    },
    "closed_accounts": {
      "type": "number",
      "description": "Nullable"
    },
    "delinquent_accounts": {
      "type": "number",
      "description": "Nullable"
    },
    "defaults": {
      "type": "number",
      "description": "Nullable"
    },
    "outstanding_balance": {
      "type": "number",
      "description": "Nullable"
    },
    "credit_utilisation": {
      "type": "number",
      "description": "Nullable, 0..1"
    },
    "recent_enquiries": {
      "type": "number",
      "description": "Nullable"
    },
    "repayment_history": {
      "type": "number",
      "description": "Nullable, 0..100"
    },
    "currency": {
      "type": "string",
      "default": "GBP"
    }
  },
  "required": [
    "organization_id",
    "application_id"
  ]
}