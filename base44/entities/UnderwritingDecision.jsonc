{
  "name": "UnderwritingDecision",
  "type": "object",
  "description": "Final lender decision. Separate from the AI recommendation. The decision_source records who/what decided.",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional free-form description of this underwriting decision."
    },
    "organization_id": {
      "type": "string"
    },
    "application_id": {
      "type": "string"
    },
    "recommendation_id": {
      "type": "string",
      "description": "The UnderwritingRecommendation this decision is based on"
    },
    "decision": {
      "type": "string",
      "enum": [
        "APPROVE",
        "REVIEW",
        "DECLINE"
      ]
    },
    "decided_by": {
      "type": "string",
      "description": "Identifier of the actor that made the decision"
    },
    "decision_source": {
      "type": "string",
      "enum": [
        "policy_engine",
        "human_underwriter",
        "automated_workflow"
      ]
    },
    "policy_id": {
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    },
    "decision_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "override_reason": {
      "type": "string",
      "description": "Required when the decision differs from the policy/recommendation"
    },
    "risk_score": {
      "type": "number"
    },
    "probability_of_default": {
      "type": "number"
    },
    "confidence": {
      "type": "number"
    },
    "human_review_required": {
      "type": "boolean",
      "default": false
    },
    "policy_outcome": {
      "type": "object"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "adverse_action_codes": {
      "type": "array",
      "description": "Standardized adverse-action reason codes (regulator-compliant) for non-approve decisions. Each item: { code, label, rule_id, reason }.",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "rule_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "adverse_action_notice": {
      "type": "object",
      "description": "Regulator-compliant adverse-action notice generated from the adverse_action_codes. Null for approve decisions. Contains: framework, statute, text, lines, generated_at.",
      "properties": {
        "framework": {
          "type": "string"
        },
        "statute": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "adverse_action_delivery": {
      "type": "object",
      "description": "Tracks delivery of the adverse-action notice to the borrower. Contains email delivery status and a shareable public-link token.",
      "properties": {
        "email_status": {
          "type": "string",
          "enum": [
            "sent",
            "failed",
            "pending"
          ]
        },
        "email_sent_at": {
          "type": "string",
          "format": "date-time"
        },
        "email_error": {
          "type": "string"
        },
        "email_sent_to": {
          "type": "string"
        },
        "share_token": {
          "type": "string",
          "description": "Random token for the public notice link at /notice/:token"
        },
        "share_token_created_at": {
          "type": "string",
          "format": "date-time"
        },
        "share_token_viewed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "idempotency_key": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "application_id",
    "decision",
    "decision_source"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}