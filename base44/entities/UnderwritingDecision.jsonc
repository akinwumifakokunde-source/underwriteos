{
  "name": "UnderwritingDecision",
  "type": "object",
  "description": "Final lender decision. Separate from the AI recommendation. The decision_source records who/what decided.",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "application_id": {
      "type": "string"
    },
    "recommendation_id": {
      "type": "string",
      "description": "The UnderwritingRecommendation this decision is based on"
    },
    "decision": {
      "type": "string",
      "enum": [
        "APPROVE",
        "REVIEW",
        "DECLINE"
      ]
    },
    "decided_by": {
      "type": "string",
      "description": "Identifier of the actor that made the decision"
    },
    "decision_source": {
      "type": "string",
      "enum": [
        "policy_engine",
        "human_underwriter",
        "automated_workflow"
      ]
    },
    "policy_id": {
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    },
    "decision_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "override_reason": {
      "type": "string",
      "description": "Required when the decision differs from the policy/recommendation"
    },
    "risk_score": {
      "type": "number"
    },
    "probability_of_default": {
      "type": "number"
    },
    "confidence": {
      "type": "number"
    },
    "human_review_required": {
      "type": "boolean",
      "default": false
    },
    "policy_outcome": {
      "type": "object"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "idempotency_key": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "application_id",
    "decision",
    "decision_source"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}