{
  "name": "ProviderCredential",
  "type": "object",
  "description": "Per-organization credentials for an external data provider (credit bureau or open banking). Each customer enters their own keys during setup; the platform uses them for outbound provider calls. client_secret is stored org-scoped and protected by RLS.",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "enum": [
        "experian",
        "equifax",
        "transunion",
        "crc",
        "credit_registry",
        "first_central",
        "truelayer",
        "yapily",
        "plaid",
        "tink",
        "other"
      ],
      "description": "Provider identifier"
    },
    "provider_type": {
      "type": "string",
      "enum": [
        "credit_bureau",
        "open_banking"
      ]
    },
    "environment": {
      "type": "string",
      "enum": [
        "sandbox",
        "production"
      ],
      "default": "sandbox"
    },
    "client_id": {
      "type": "string"
    },
    "client_secret": {
      "type": "string",
      "description": "Stored per-organization; used only for outbound provider calls. Never returned in full by the API."
    },
    "base_url": {
      "type": "string",
      "description": "Provider API base URL (e.g. https://api-sandbox.experian.com)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "disabled"
      ],
      "default": "active"
    },
    "last_tested": {
      "type": "string",
      "format": "date-time"
    },
    "last_test_status": {
      "type": "string",
      "enum": [
        "ok",
        "failed",
        "untested"
      ],
      "default": "untested"
    },
    "last_test_error": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "provider",
    "provider_type",
    "client_id",
    "client_secret"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}