{
  "name": "Document",
  "type": "object",
  "description": "Uploaded document for an application. Documents are auto-classified, processed via AI extraction, and linked to evidence records for full provenance.",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "application_id": {
      "type": "string"
    },
    "document_reference": {
      "type": "string"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "credit_report",
        "bank_statement",
        "payslip",
        "identity",
        "employment",
        "tax",
        "financial_statement",
        "proof_of_address",
        "other_financial",
        "other"
      ]
    },
    "file_url": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "mime_type": {
      "type": "string"
    },
    "file_format": {
      "type": "string",
      "enum": [
        "pdf",
        "csv",
        "json",
        "image",
        "other"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "uploaded",
        "processing",
        "processed",
        "verified",
        "needs_review",
        "failed"
      ],
      "default": "uploaded"
    },
    "extracted_data": {
      "type": "object",
      "description": "Structured extraction result: fields array with name, value, confidence, source; processing_steps; overall_confidence."
    },
    "confidence": {
      "type": "number",
      "description": "Overall extraction confidence (0..1)."
    },
    "extracted_fields_count": {
      "type": "number",
      "default": 0
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Detected inconsistencies or quality issues."
    },
    "source_reference": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "application_id",
    "document_type"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}