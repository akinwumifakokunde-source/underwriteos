{
  "name": "Evidence",
  "type": "object",
  "description": "Evidence graph node. Every risk signal is traceable to its source through this record.",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "application_id": {
      "type": "string"
    },
    "signal_id": {
      "type": "string",
      "description": "The RiskSignal this evidence supports"
    },
    "signal": {
      "type": "string",
      "description": "Signal name (denormalized for query)"
    },
    "value": {
      "type": [
        "number",
        "string",
        "boolean"
      ]
    },
    "value_type": {
      "type": "string",
      "enum": [
        "number",
        "string",
        "boolean"
      ]
    },
    "currency": {
      "type": "string"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "credit_report",
        "bank_statement",
        "document",
        "borrower_declaration",
        "derived",
        "ai_analysis"
      ]
    },
    "source_provider": {
      "type": "string",
      "description": "Provider that produced the source record (e.g. experian, truelayer). Null when derived."
    },
    "source_id": {
      "type": "string",
      "description": "ID of the source record (CreditReport, BankStatement, Document, etc.)"
    },
    "document_id": {
      "type": "string",
      "description": "Document ID where applicable"
    },
    "source_location": {
      "type": "string",
      "description": "Location/page within the source where the value was found"
    },
    "field": {
      "type": "string",
      "description": "Specific field within the source this evidence was extracted from"
    },
    "calculation_method": {
      "type": "string",
      "description": "How the value was derived (e.g. 'sum', 'avg', 'ratio', 'direct_extract')"
    },
    "confidence": {
      "type": "number"
    }
  },
  "required": [
    "organization_id",
    "application_id",
    "signal",
    "source_type"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}