      "type": "string"
    },
    "signal": {
      "type": "string"
    },
    "value": {
      "type": [
        "number",
        "string",
        "boolean"
      ]
    },
    "value_type": {
      "type": "string",
      "enum": [
        "number",
        "string",
        "boolean"
      ]
    },
    "currency": {
      "type": "string"
    },
    "source": {
      "type": "string",
