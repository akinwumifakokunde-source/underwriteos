{
  "name": "Credit",
  "type": "object",
  "description": "Per-organization credit balance. Decremented on billable API calls; topped up via Stripe checkout or auto top-up. Tracks active subscription.",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "balance": {
      "type": "number",
      "default": 0,
      "description": "Current credit balance"
    },
    "currency": {
      "type": "string",
      "default": "usd"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe customer used for subscriptions and off-session auto top-up charges"
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "Active Stripe subscription id, if subscribed"
    },
    "subscription_plan_id": {
      "type": "string",
      "description": "Subscribed plan id (plan_starter, plan_growth, plan_scale)"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "active",
        "trialing",
        "past_due",
        "canceled",
        "incomplete",
        "none"
      ],
      "default": "none",
      "description": "Stripe subscription status"
    },
    "subscription_current_period_end": {
      "type": "string",
      "format": "date-time",
      "description": "End of the current subscription billing period"
    },
    "auto_topup_enabled": {
      "type": "boolean",
      "default": false
    },
    "auto_topup_threshold": {
      "type": "number",
      "default": 1000,
      "description": "Balance below which auto top-up triggers"
    },
    "auto_topup_amount": {
      "type": "number",
      "default": 10000,
      "description": "Credits added per auto top-up"
    },
    "auto_topup_price_cents": {
      "type": "number",
      "default": 2000,
      "description": "Amount charged per auto top-up (cents)"
    }
  },
  "required": [
    "organization_id"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}