{
  "name": "Credit",
  "type": "object",
  "description": "Per-organization credit balance. Decremented on billable API calls; topped up via Stripe checkout or auto top-up.",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "balance": {
      "type": "number",
      "default": 0,
      "description": "Current credit balance"
    },
    "currency": {
      "type": "string",
      "default": "usd"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe customer used for off-session auto top-up charges"
    },
    "auto_topup_enabled": {
      "type": "boolean",
      "default": false
    },
    "auto_topup_threshold": {
      "type": "number",
      "default": 1000,
      "description": "Balance below which auto top-up triggers"
    },
    "auto_topup_amount": {
      "type": "number",
      "default": 10000,
      "description": "Credits added per auto top-up"
    },
    "auto_topup_price_cents": {
      "type": "number",
      "default": 2000,
      "description": "Amount charged per auto top-up (cents)"
    }
  },
  "required": [
    "organization_id"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}