{
  "name": "InformationRequest",
  "type": "object",
  "description": "A request from the lender to the borrower for missing information needed to complete underwriting. Tracks the request lifecycle from requested through resolved, and feeds application status.",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "application_id": {
      "type": "string"
    },
    "item": {
      "type": "string",
      "description": "What is being requested (e.g. 'Credit report', 'Proof of address')"
    },
    "note": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "sent",
        "viewed",
        "received",
        "verified",
        "resolved"
      ],
      "default": "requested"
    },
    "requested_by": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organization_id",
    "application_id",
    "item"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}