{
  "description": "Generates and publishes one Insights article per weekday (9am, Mon-Fri) across five content pillars: Mon=A (AI Underwriting), Tue=B (Credit Decisioning), Wed=C (Document Intelligence), Thu=D (Lending Operations), Fri=E (AI + Responsible Lending, flagship). Friday's pillar positions CreditDecide as the infrastructure layer for responsible AI underwriting, anchored to the FCA's 2026 AI agenda. Then shares the new article \u2014 with an AI-generated cover image \u2014 to the CreditDecide LinkedIn company page.",
  "name": "Daily Insights",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * 1-5",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_insights",
      "version": "1.2",
      "namespace": "base44"
    },
    "do": [
      {
        "generate": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "apiInsights",
            "args": {
              "generate": true
            }
          },
          "then": "post_linkedin",
          "x-base44": {
            "title": "Generate insight article",
            "description": "AI-generate and publish today's pillar article (A-E by weekday)"
          }
        }
      },
      {
        "post_linkedin": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "apiLinkedInPost",
            "args": {
              "slug": "${ .generate.slug }",
              "title": "${ .generate.title }",
              "excerpt": "${ .generate.excerpt }",
              "market": "${ .generate.market }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Post to LinkedIn",
            "description": "Share the new article with a cover image on the company page"
          }
        }
      }
    ]
  }
}