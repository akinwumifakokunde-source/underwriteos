{
  "description": "Generates and publishes one borderless, consumer-lending-focused Insights article per weekday (9am, Mon-Fri), rotating across feature/innovation/strategy topics, then shares the new article \u2014 with an AI-generated cover image \u2014 to the CreditDecide LinkedIn company page.",
  "name": "Daily Insights",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * 1-5",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_insights",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
        "generate": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "apiInsights",
            "args": {
              "generate": true
            }
          },
          "then": "post_linkedin",
          "x-base44": {
            "title": "Generate insight article",
            "description": "AI-generate and publish one borderless consumer-lending article"
          }
        }
      },
      {
        "post_linkedin": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "apiLinkedInPost",
            "args": {
              "slug": "${ .generate.slug }",
              "title": "${ .generate.title }",
              "excerpt": "${ .generate.excerpt }",
              "market": "${ .generate.market }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Post to LinkedIn",
            "description": "Share the new article with a cover image on the company page"
          }
        }
      }
    ]
  }
}