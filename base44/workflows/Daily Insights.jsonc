{
  "name": "Daily Insights",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_insights",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "generate": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "apiInsights",
            "args": {
              "generate": true
            }
          },
          "then": "post_linkedin",
          "x-base44": {
            "title": "Generate insight article",
            "description": "AI-generate and publish one market-targeted article"
          }
        }
      },
      {
        "post_linkedin": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "apiLinkedInPost",
            "args": {
              "slug": "${ .generate.slug }",
              "title": "${ .generate.title }",
              "excerpt": "${ .generate.excerpt }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Post to LinkedIn",
            "description": "Share the new article on the company page"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9,14 * * 1-5",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Generates and publishes two SEO/GEO-optimized Insights articles per weekday (9am and 2pm, Mon-Fri), rotating across the six supported markets (UK, US, Nigeria, South Africa, Kenya, Ghana), then shares each new article to the CreditDecide LinkedIn company page."
}