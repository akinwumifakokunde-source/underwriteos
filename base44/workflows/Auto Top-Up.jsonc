{
  "description": "Hourly check: charges organizations with auto top-up enabled whose credit balance is below their configured threshold.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_topup",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_topup": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "apiBilling",
            "args": {
              "action": "auto_topup_run_all"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Run auto top-up",
            "description": "Charge orgs below threshold"
          }
        }
      }
    ]
  },
  "name": "Auto Top-Up",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}