{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "webhook_retry_queue",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "retry": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "apiWebhookRetry",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Retry failed deliveries",
            "description": "Exponential backoff: 1m, 5m, 30m"
          }
        }
      }
    ]
  },
  "name": "Webhook Retry Queue",
  "description": "Retries failed webhook deliveries with exponential backoff (1m, 5m, 30m). Runs every 5 minutes to pick up deliveries due for retry."
}